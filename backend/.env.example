APP_NAME=upay-financial-life-copilot
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Financial policy
MINIMUM_BALANCE_BUFFER=5000
BUFFER_FLOOR_MONTHS=1
EMERGENCY_FUND_MONTHS=3

# LLM providers (REST; SDKs not required)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama-3.1-70b-versatile

# Voice (env-pluggable)
STT_PROVIDER=env
TTS_PROVIDER=env
STT_API_KEY=
TTS_API_KEY=

# Storage
USE_POSTGRES=false
DATABASE_URL=
